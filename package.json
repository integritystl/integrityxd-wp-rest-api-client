    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jest": "^30.0.2",
    "msw": "^2.3.5",
    "node-fetch": "^3.3.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.1.0"
  },
  "dependencies": {
